# ============================================================
# CampusEquip — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to git.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=production

# --- JWT Auth (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# --- CORS: set to your Vercel frontend URL after deploying ---
# Leave blank if using unified Railway deployment (frontend + backend together)
CLIENT_URL=https://your-app-name.vercel.app

# --- Supabase (required for cloud deployment) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
