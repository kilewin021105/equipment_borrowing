{
  "name": "campusequip-system",
  "version": "1.0.0",
  "description": "College Equipment Borrowing and Inventory Management System",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/startup.js",
    "seed": "node server/db/seed.js",
    "transfer:supabase": "node server/scripts/transfer_to_supabase.js",
    "dev:server": "node server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node server/tests/test_api.js",
    "test:all": "node server/tests/test_api.js && node server/tests/verify_frontend_and_api.js"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}